# --- データベース（サーバー専用。NEXT_PUBLIC_ を付けない）---
# 公開環境：Vercel の Storage から Neon を接続すると DATABASE_URL と DATABASE_URL_UNPOOLED が自動で入る
DATABASE_URL=postgres://postgres:postgres@localhost:5432/im
# DATABASE_URL_UNPOOLED=

# --- 見本の会社のログイン用パスワード（公開環境では必須・12文字以上）---
# ローカルで未設定なら demo-login-2026
# SEED_LOGIN_PASSWORD=

# --- 毎日の定期処理（Vercel Cron）の合言葉（公開環境では必須・16文字以上）---
CRON_SECRET=

# --- デモ（任意）---
# DEMO_MAX_ACTIVE=50
# DEMO_CREATE_LIMIT_PER_HOUR=30
